{
  "name": "secrets-axi",
  "version": "0.1.15",
  "description": "Secrets guard CLI for agents - denies .env and credential reads with the right command instead, runs commands with secrets injected and output masked, lists variable names and shapes without values",
  "type": "module",
  "keywords": [
    "secrets",
    "dotenv",
    "cli",
    "agent",
    "axi",
    "toon",
    "hooks",
    "claude-code",
    "codex"
  ],
  "bin": {
    "secrets-axi": "dist/bin/secrets-axi.js"
  },
  "files": [
    "dist",
    "skills/secrets-axi",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc && node -e \"require('fs').chmodSync('dist/bin/secrets-axi.js', 0o755)\"",
    "build:skill": "tsx scripts/build-skill.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "check": "pnpm run typecheck && pnpm run build && pnpm run test && pnpm run build:skill -- --check",
    "dev": "tsx bin/secrets-axi.ts",
    "prepublishOnly": "pnpm run check"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@toon-format/toon": "^4.1.1",
    "axi-sdk-js": "^0.1.13"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3",
    "vitest": "^5.0.1"
  },
  "author": "Cristian Mos",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cmosgh/secrets-axi.git"
  },
  "homepage": "https://github.com/cmosgh/secrets-axi#readme",
  "bugs": {
    "url": "https://github.com/cmosgh/secrets-axi/issues"
  },
  "packageManager": "pnpm@10.28.2"
}
